   "source": [
    "import numpy as np\n",
    "from statsmodels.stats.power import TTestPower\n",
    "import math\n",
    "\n",
    "# 1. Define the a priori target effect size in Rosenthal's r\n",
    "target_rosenthal_r = 0.15  # The target effect size for the Wilcoxon\n",
    "alpha = 0.05            \n",
    "power = 0.80            \n",
    "\n",
    "# 2. Convert Rosenthal's r to Cohen's dz for the TTestPower solver\n",
    "# Formula: dz = r / sqrt(1 - r^2)\n",
    "effect_size_dz = target_rosenthal_r / math.sqrt(1 - (target_rosenthal_r**2))\n",
    "\n",
    "# 3. Calculate the required sample size for a Parametric Paired T-Test\n",
    "ttest_power_solver = TTestPower()\n",
    "n_ttest = ttest_power_solver.solve_power(\n",
    "    effect_size=effect_size_dz, \n",
    "    alpha=alpha, \n",
    "    power=power, \n",
    "    alternative='two-sided'\n",
    ")\n",
    "\n",
    "# 4. Apply the Pitman Asymptotic Relative Efficiency (A.R.E.) for Wilcoxon\n",
    "# The A.R.E. of Wilcoxon to t-test under normality is 3/pi\n",
    "are_adjustment = 3 / math.pi\n",
    "n_wilcoxon = n_ttest / are_adjustment\n",
    "\n",
    "# 5. Round up to the nearest whole integer\n",
    "required_n = math.ceil(n_wilcoxon)\n",
    "\n",
    "print(f\"Target Rosenthal's r:    {target_rosenthal_r}\")\n",
    "print(f\"Converted Cohen's dz:    {effect_size_dz:.4f}\")\n",
    "print(f\"Alpha (Type I Error):    {alpha}\")\n",
    "print(f\"Target Power (1 - Beta): {power}\")\n",
    "print(\"-\" * 60)\n",
    "print(f\"Raw T-Test N:            {n_ttest:.2f}\")\n",
    "print(f\"A.R.E. Adjustment Factor:{are_adjustment:.4f}\")\n",
    "print(f\"Exact Wilcoxon N:        {n_wilcoxon:.2f}\")\n",
    "print(\"-\" * 60)\n",
    "print(f\"REQUIRED SAMPLE SIZE:    {required_n} pairs\")"
   ]
  },
